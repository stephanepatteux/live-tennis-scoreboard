# Live Tennis Scoreboard configuration.
# Copy to .env and adjust as needed. All values have safe defaults.

# Names shown on the scoreboard.
PLAYER1_NAME=Player 1
PLAYER2_NAME=Player 2

# Number of sets a player must win to take the match (2 = best of 3).
SETS_TO_WIN=2

# Dev server bind settings (used by `python wsgi.py`).
HOST=127.0.0.1
PORT=5000

# Set to 1 to enable Flask debug/auto-reload in local development.
FLASK_DEBUG=0
