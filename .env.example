# Tennis Trader Board configuration.
# Copy to .env and fill in. NEVER commit your real .env — it is git-ignored.

# --- Live Tennis API ---------------------------------------------------------
# Your Live Tennis API key. Leave BLANK to run in demo mode (simulated scores,
# no key required). Get a key (Ultra recommended for the model + push feed):
#   https://affiliates.livetennisapi.com/r/botblog   (use code: botblog)
LIVE_TENNIS_API_KEY=

# API base URL (rarely needs changing).
LIVE_TENNIS_API_BASE=https://api.livetennisapi.com/api/public/v1

# Seconds to wait on the upstream API before giving up.
LIVE_TENNIS_API_TIMEOUT=8

# When 1 (default), fill the Model column with a local heuristic estimate if the
# provider does not return a model probability (e.g. on the free plan). Set to 0
# to show "—" instead and only trust the provider's own model (Ultra).
MODEL_FALLBACK=1

# --- Board behaviour ---------------------------------------------------------
# Seconds to cache one upstream refresh and share it across all viewers.
FEED_CACHE_TTL=8

# --- Dev server (used by `python wsgi.py`) -----------------------------------
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
