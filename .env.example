# Tennis Trader Board configuration.
# Copy to .env and fill in. NEVER commit your real .env — it is git-ignored.

# --- Live Tennis API (ULTRA key required for real point-by-point push) -------
# This board is push-only: it streams each point over the Live Tennis API Ultra
# WebSocket. Real-time push REQUIRES an ULTRA key — lower tiers cannot open the
# push feed (see the README for why).
#
# Leave BLANK to run in DEMO mode (locally simulated points, no key). Demo mode
# is only for previewing the UI; it is not real data.
#
# Get an Ultra key (affiliate link, code: botblog):
#   https://affiliates.livetennisapi.com/r/botblog
LIVE_TENNIS_API_KEY=

# API base URL (rarely needs changing). /ws-token is minted from here.
LIVE_TENNIS_API_BASE=https://api.livetennisapi.com/api/public/v1

# Seconds to wait when minting the WebSocket token / connecting.
LIVE_TENNIS_API_TIMEOUT=10

# When 1 (default), fill the Model column with a local heuristic estimate if a
# frame has no model probability. Set to 0 to trust only the provider's model.
MODEL_FALLBACK=1

# Demo mode only: seconds between simulated points (lower = faster demo).
DEMO_POINT_INTERVAL=1.0

# --- Dev server (used by `python wsgi.py`) -----------------------------------
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
